{
  "name": "quest-perimetry-portal",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Doctor portal for Quest Perimetry. Research prototype, not registered with ANVISA.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "create-user": "node scripts/create-user.ts"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "playwright-core": "1.56.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
