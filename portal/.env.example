# PostgreSQL
DATABASE_URL="postgresql://perimetry:perimetry@localhost:5432/perimetry"
# 32 random bytes, base64. Encrypts patient identifiers and device keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes encrypted fields unreadable. Never commit the real one.
PERIMETRY_DATA_KEY=""
# Command that runs the /core CLI (analysis). Default: the Release build in ../artifacts.
# PERIMETRY_CLI="dotnet ../artifacts/bin/Perimetry.Cli/release/perimetry.dll"
# Clinical config directory (default ../config).
# PERIMETRY_CONFIG_DIR="../config"
# Chromium for PDF export (default: Playwright's browser in PLAYWRIGHT_BROWSERS_PATH).
# PERIMETRY_CHROMIUM_PATH=""
# Set to "true" behind HTTPS so session cookies are Secure (also turns on HSTS and upgrade-insecure-requests).
# PERIMETRY_SECURE_COOKIES="true"
# Staff session idle timeout in minutes (default 60; the absolute limit is 12 h).
# SESSION_IDLE_MINUTES="60"
