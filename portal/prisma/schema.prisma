// Doctor portal data model (Phase 3). Fields ending in "Enc" are AES-256-GCM ciphertext (src/lib/crypto.ts);
// fields ending in "Idx" are keyed blind indexes for exact-match lookup without decrypting.
// Raw exam files are kept byte-for-byte (rawText) so their HMAC can be re-verified at any time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  doctor
  operator
}

enum Integrity {
  verified
  unverified
  failed
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  role         Role        @default(doctor)
  passwordHash String
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  /// Phase 6 (security): consecutive failed logins and the lockout they triggered; reset on success.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  sessions     Session[]
  accessLogs   AccessLog[]
}

model Session {
  id        String   @id // SHA-256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  /// Phase 6: idle expiry (SESSION_IDLE_MINUTES); touched at most once a minute.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Patient {
  id               String      @id @default(cuid())
  /// Pseudonymous code written to the headset (exam-order patientRef) and to research exports. Never a name.
  code             String      @unique
  internalIdEnc    String
  internalIdIdx    String      @unique
  nameEnc          String
  nameIdx          String
  birthDateEnc     String
  sexEnc           String?
  refractionEnc    String?
  diagnosisEnc     String?
  consentAt        DateTime?
  consentById      String?
  consentNote      String?
  /// Version of the consent text (src/lib/consent-text.ts) the patient agreed to.
  consentVersion   String?
  researchConsent  Boolean     @default(false)
  researchConsentAt   DateTime?
  researchConsentById String?
  /// LGPD erasure request: identifying fields replaced by markers, exams kept under the pseudonymous code.
  anonymizedAt     DateTime?
  anonymizedById   String?
  createdAt        DateTime    @default(now())
  createdById      String
  exams            Exam[]
  orders           ExamOrder[]

  @@index([nameIdx])
}

model Device {
  id           String        @id @default(cuid())
  serial       String        @unique
  model        String?
  label        String?
  /// Per-device HMAC key (base64, from device.key on the headset), encrypted at rest. Enables integrity checks.
  hmacKeyEnc   String?
  createdAt    DateTime      @default(now())
  calibrations Calibration[]
  sessions     HeadsetSession[]
  tokens       DeviceToken[]
  pairingCodes PairingCode[]
  orders       ExamOrder[]
  liveSessions LiveSession[]
}

/// Short code the doctor generates on the Headsets page; the headset exchanges it once for a token (docs/SYNC_API.md).
model PairingCode {
  id          String    @id @default(cuid())
  /// SHA-256 of the normalised code (no hyphens, upper case); the code itself is shown once.
  codeHash    String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id])
}

/// Bearer token of a paired headset. id = SHA-256 of the token; the token itself is never stored.
model DeviceToken {
  id         String    @id
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  software   String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  /// Optional hard expiry set when pairing (docs/SYNC_API.md); null = until revoked.
  expiresAt  DateTime?

  @@index([deviceId])
}

model Calibration {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  measuredAt   DateTime?
  validUntil   DateTime?
  photometer   String?
  /// LuminanceCalibration JSON exactly as validated by the /core CLI.
  json         String
  summary      Json
  uploadedById String
  uploadedAt   DateTime  @default(now())
  active       Boolean   @default(true)
}

model ExamOrder {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  presetId    String
  ageYears    Float
  refraction  String?
  seed        String?
  /// Phase 5 options written to exam-order.json when set; null = the preset's own value (grid, fixation) or off.
  gridId          String?
  fixationMode    String?
  fovealThreshold Boolean?
  responseMode    String?
  createdById String
  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?
  /// Headset the order was sent to (GET /api/headset/orders); null = download only.
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id])
  sentAt      DateTime?
  cancelledAt DateTime?

  @@index([deviceId, fulfilledAt, cancelledAt])
}

/// Latest live snapshot of a headset session (POST /api/headset/live); the in-memory copy feeds the panel.
model LiveSession {
  id          String        @id @default(cuid())
  sessionId   String        @unique
  deviceId    String?
  device      Device?       @relation(fields: [deviceId], references: [id])
  patientRef  String?
  orderId     String?
  startedUtc  DateTime
  lastSeenUtc DateTime
  state       String
  finished    Boolean       @default(false)
  outcome     String?
  seq         Int           @default(0)
  snapshot    Json
  commands    LiveCommand[]

  @@index([lastSeenUtc])
}

/// pause / resume / abort sent by a doctor to a running session; acked by the headset.
model LiveCommand {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  type          String
  issuedById    String
  issuedAt      DateTime    @default(now())
  deliveredAt   DateTime?
  ackedAt       DateTime?

  @@index([liveSessionId, ackedAt])
}

model HeadsetSession {
  id         String    @id @default(cuid())
  sessionId  String    @unique
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id])
  startedUtc DateTime
  outcome    String?
  rawText    String
  data       Json
  integrity  Integrity @default(unverified)
  importedAt DateTime  @default(now())
  exams      Exam[]
}

model Exam {
  id               String          @id @default(cuid())
  examId           String
  startedUtc       DateTime
  patientId        String?
  patient          Patient?        @relation(fields: [patientId], references: [id])
  sessionId        String?
  session          HeadsetSession? @relation(fields: [sessionId], references: [id])
  eye              String
  gridId           String
  strategy         String
  aborted          Boolean         @default(false)
  configHash       String?
  calibrated       Boolean         @default(false)
  /// The headset file, byte-for-byte (may contain "NaN" strings).
  rawText          String
  rawHmac          String?
  integrity        Integrity       @default(unverified)
  /// Output of `perimetry report` (strict JSON): exam summary + Single Field Analysis from /core.
  report           Json
  analyzedConfig   String
  md               Float?
  vfi              Float?
  psd              Float?
  ght              String?
  /// Phase 5: foveal threshold (HFA-equivalent dB, null = not tested) and whether gaze was tracked, for the lists.
  fovealHfaDb      Float?
  gazeTracked      Boolean         @default(false)
  /// Null when the headset uploaded the file itself (POST /api/headset/exams); the access log names the device.
  importedById     String?
  importedAt       DateTime        @default(now())

  @@unique([examId, startedUtc])
  @@index([patientId, eye, startedUtc])
}

model AccessLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  detail     String?
  ip         String?

  @@index([entityType, entityId])
  @@index([at])
}
